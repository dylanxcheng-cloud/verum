# Environment variables for Verum News
# Copy this to .env.local and fill in actual values

# Groq API (for AI rewriting in auto_publish.py)
VITE_GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL — Groq model id. Optional; defaults to openai/gpt-oss-20b
# (llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17). Set this to
# switch models without code changes.
GROQ_MODEL=openai/gpt-oss-20b

# Netlify deployment
VITE_NETLIFY_SITE_ID=your_netlify_site_id
VITE_NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# API endpoints
VITE_API_BASE_URL=http://localhost:5000
VITE_STORIES_URL=/stories.json
VITE_RECORDATIONEM_URL=/recordationem.json

# Recordationem discovery engine (auto_publish.py / recordationem.py)
# RECORDATIONEM_THRESHOLD — recordationemScore cutoff for surfacing a topic
# RECORDATIONEM_MAX       — max topics published per run
RECORDATIONEM_THRESHOLD=5
RECORDATIONEM_MAX=60

# App settings
VITE_REFRESH_INTERVAL=300000
VITE_MAX_STORIES_PER_PAGE=20
