# Environment variables for Verum News
# Copy this to .env.local and fill in actual values

# Groq API (for AI rewriting in auto_publish.py)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Netlify deployment
VITE_NETLIFY_SITE_ID=your_netlify_site_id
VITE_NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# API endpoints
VITE_API_BASE_URL=http://localhost:5000
VITE_STORIES_URL=/stories.json

# App settings
VITE_REFRESH_INTERVAL=300000
VITE_MAX_STORIES_PER_PAGE=20
